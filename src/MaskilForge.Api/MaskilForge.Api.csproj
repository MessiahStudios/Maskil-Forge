<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\MaskilForge.Domain\MaskilForge.Domain.csproj" />
    <ProjectReference Include="..\MaskilForge.Engine\MaskilForge.Engine.csproj" />
    <ProjectReference Include="..\MaskilForge.Infrastructure\MaskilForge.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="CopyWebClientToPublish" AfterTargets="Publish" Condition="Exists('..\MaskilForge.Web\dist\index.html')">
    <ItemGroup>
      <WebClientFile Include="..\MaskilForge.Web\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebClientFile)" DestinationFiles="@(WebClientFile->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="$(IntermediateOutputPath)native/maskil-vst3-probe" Link="native/maskil-vst3-probe"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildMacVst3Probe" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Inputs="$(MSBuildProjectDirectory)/../../native/vst3-probe-macos.c"
          Outputs="$(IntermediateOutputPath)native/maskil-vst3-probe">
    <MakeDir Directories="$(IntermediateOutputPath)native" />
    <Exec Command="/usr/bin/clang -std=c11 -Wall -Wextra -Werror -O2 -framework CoreFoundation &quot;$(MSBuildProjectDirectory)/../../native/vst3-probe-macos.c&quot; -o &quot;$(IntermediateOutputPath)native/maskil-vst3-probe&quot;" />
  </Target>

</Project>
