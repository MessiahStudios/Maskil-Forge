<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\MaskilForge.Domain\MaskilForge.Domain.csproj" />
    <ProjectReference Include="..\MaskilForge.Engine\MaskilForge.Engine.csproj" />
    <ProjectReference Include="..\MaskilForge.Infrastructure\MaskilForge.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="CopyWebClientToPublish" AfterTargets="Publish" Condition="Exists('..\MaskilForge.Web\dist\index.html')">
    <ItemGroup>
      <WebClientFile Include="..\MaskilForge.Web\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebClientFile)" DestinationFiles="@(WebClientFile->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
